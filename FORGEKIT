
#!/usr/bin/env python3
"""
FORGEKIT
Professional GitHub Repository Builder

Features:
- Create GitHub repositories through GitHub REST API
- Initialize local Git repositories
- Generate README.md, .gitignore and LICENSE
- Configure Git remote
- Commit and push automatically

Requirements:
- Python 3.10+
- Git installed and available in PATH
- GitHub Personal Access Token with repository permissions

Environment:
    GH_TOKEN=your_github_token

Usage:
    python forgekit.py
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

from datetime import datetime, timezone
from pathlib import Path


# ============================================================
# CONFIGURATION
# ============================================================

APP_NAME = "FORGEKIT"
APP_VERSION = "1.0.0"

GITHUB_API = "https://api.github.com"

GITIGNORE_TEMPLATE = """# Python
__pycache__/
*.py[cod]
*.so
.Python
venv/
.env
.env.*
.pytest_cache/

# Node
node_modules/
dist/
build/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
"""

MIT_LICENSE = """MIT License

Copyright (c) {year} {owner}

Permission is hereby granted, free of charge, to any person
obtaining a copy of this software and associated documentation
files (the "Software"), to deal in the Software without
restriction, including without limitation the rights to use,
copy, modify, merge, publish, distribute, sublicense,
and/or sell copies of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND.
"""


# ============================================================
# TERMINAL UI
# ============================================================

class UI:

    @staticmethod
    def banner():
        print(r"""
  ______ ____  ____  _____ ______ _  ______ _____
 |  ____/ __ \|  _ \|  __ \|  ____| |/ /  ____|_   _|
 | |__ | |  | | |_) | |__) | |__  | ' /| |__    | |
 |  __|| |  | |  _ <|  _  /|  __| |  < |  __|   | |
 | |   | |__| | |_) | | \ \| |____| . \| |____ _| |_
 |_|    \____/|____/|_|  \_\______|_|\_\______|_____|

       Professional GitHub Repository Builder
                    Version 1.0.0
        """)

    @staticmethod
    def success(message):
        print(f"\n[+] {message}")

    @staticmethod
    def error(message):
        print(f"\n[ERROR] {message}")

    @staticmethod
    def info(message):
        print(f"[*] {message}")


# ============================================================
# GITHUB CLIENT
# ============================================================

class GitHubClient:

    def __init__(self, token: str):
        self.token = token

    def request(self, endpoint: str, method="GET", data=None):

        url = f"{GITHUB_API}{endpoint}"

        payload = None
        if data is not None:
            payload = json.dumps(data).encode("utf-8")

        request = urllib.request.Request(
            url,
            data=payload,
            method=method,
            headers={
                "Accept": "application/vnd.github+json",
                "Authorization": f"Bearer {self.token}",
                "X-GitHub-Api-Version": "2022-11-28",
                "Content-Type": "application/json",
                "User-Agent": APP_NAME
            }
        )

        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                return json.loads(response.read().decode("utf-8"))

        except urllib.error.HTTPError as exc:
            try:
                details = json.loads(exc.read().decode("utf-8"))
                message = details.get("message", str(exc))
            except Exception:
                message = str(exc)

            raise RuntimeError(
                f"GitHub API error ({exc.code}): {message}"
            ) from exc

        except urllib.error.URLError as exc:
            raise RuntimeError(
                f"Network connection failed: {exc.reason}"
            ) from exc

    def get_user(self):
        return self.request("/user")

    def create_repository(
        self,
        name,
        description,
        private=True
    ):

        return self.request(
            "/user/repos",
            method="POST",
            data={
                "name": name,
                "description": description,
                "private": private,
                "auto_init": False,
                "has_issues": True,
                "has_projects": True,
                "has_wiki": False
            }
        )


# ============================================================
# INPUT VALIDATION
# ============================================================

def validate_repo_name(name: str):

    if not re.fullmatch(
        r"[A-Za-z0-9._-]+",
        name
    ):
        raise ValueError(
            "Repository name contains invalid characters."
        )

    if name in {".", ".."}:
        raise ValueError("Invalid repository name.")

    return name


# ============================================================
# GIT OPERATIONS
# ============================================================

def run_git(command, cwd=None):

    try:
        result = subprocess.run(
            ["git"] + command,
            cwd=cwd,
            check=True,
            capture_output=True,
            text=True
        )

        return result.stdout.strip()

    except FileNotFoundError:
        raise RuntimeError(
            "Git is not installed or is not available in PATH."
        )

    except subprocess.CalledProcessError as exc:
        message = exc.stderr.strip() or exc.stdout.strip()

        raise RuntimeError(
            f"Git command failed: {message}"
        ) from exc


def initialize_repository(
    project_path: Path,
    repository_url: str,
    owner: str,
    repo_name: str,
    description: str,
    include_license=True
):

    project_path.mkdir(parents=True, exist_ok=True)

    readme = project_path / "README.md"

    if not readme.exists():
        readme.write_text(
            f"""# {repo_name}

{description}

## Overview

A new project powered by {APP_NAME}.

## Getting Started

Clone the repository:

```bash
git clone {repository_url}
```

## Project Structure

```text
{repo_name}/
├── README.md
├── .gitignore
└── LICENSE
```

## License

See the LICENSE file for details.
""",
            encoding="utf-8"
        )

    gitignore = project_path / ".gitignore"

    if not gitignore.exists():
        gitignore.write_text(
            GITIGNORE_TEMPLATE,
            encoding="utf-8"
        )

    license_file = project_path / "LICENSE"

    if include_license and not license_file.exists():
        license_file.write_text(
            MIT_LICENSE.format(
                year=datetime.now(timezone.utc).year,
                owner=owner
            ),
            encoding="utf-8"
        )

    if not (project_path / ".git").exists():
        run_git(["init", "-b", "main"], cwd=project_path)

    run_git(["add", "."], cwd=project_path)

    status = run_git(
        ["status", "--porcelain"],
        cwd=project_path
    )

    if status:
        run_git(
            ["commit", "-m", "Initial commit"],
            cwd=project_path
        )
    else:
        UI.info("No new changes to commit.")

    remotes = run_git(
        ["remote"],
        cwd=project_path
    ).splitlines()

    if "origin" in remotes:
        current_url = run_git(
            ["remote", "get-url", "origin"],
            cwd=project_path
        )

        if current_url != repository_url:
            raise RuntimeError(
                "The local project already has a different origin remote."
            )
    else:
        run_git(
            ["remote", "add", "origin", repository_url],
            cwd=project_path
        )

    run_git(
        ["push", "-u", "origin", "main"],
        cwd=project_path
    )


# ============================================================
# APPLICATION
# ============================================================

def main():

    UI.banner()

    parser = argparse.ArgumentParser(
        description="Create and publish GitHub repositories."
    )

    parser.add_argument(
        "--name",
        help="Repository name"
    )

    parser.add_argument(
        "--description",
        default="A project created with Forgekit.",
        help="Repository description"
    )

    parser.add_argument(
        "--visibility",
        choices=["public", "private"],
        default="private",
        help="Repository visibility"
    )

    parser.add_argument(
        "--directory",
        help="Local project directory"
    )

    parser.add_argument(
        "--no-license",
        action="store_true",
        help="Skip MIT License generation"
    )

    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Validate settings without creating a repository"
    )

    args = parser.parse_args()

    try:

        token = os.environ.get("GH_TOKEN")

        if not token:
            raise RuntimeError(
                "GH_TOKEN environment variable is not configured."
            )

        repo_name = args.name or input(
            "Repository name: "
        ).strip()

        validate_repo_name(repo_name)

        description = args.description

        directory = Path(
            args.directory or repo_name
        ).expanduser().resolve()

        private = args.visibility == "private"

        UI.info(f"Repository: {repo_name}")
        UI.info(f"Visibility: {args.visibility}")
        UI.info(f"Directory: {directory}")

        if args.dry_run:
            UI.success("Configuration validated. No changes made.")
            return

        github = GitHubClient(token)

        UI.info("Authenticating with GitHub...")

        user = github.get_user()
        owner = user["login"]

        UI.success(f"Authenticated as @{owner}")

        UI.info("Creating GitHub repository...")

        repository = github.create_repository(
            name=repo_name,
            description=description,
            private=private
        )

        clone_url = repository["clone_url"]
        html_url = repository["html_url"]

        UI.success(f"Repository created: {html_url}")

        UI.info("Generating project files...")

        initialize_repository(
            project_path=directory,
            repository_url=clone_url,
            owner=owner,
            repo_name=repo_name,
            description=description,
            include_license=not args.no_license
        )

        UI.success("Git repository initialized.")
        UI.success("Files committed and pushed successfully.")

        print("\n" + "=" * 60)
        print("                 PROJECT PUBLISHED")
        print("=" * 60)
        print(f"Owner      : {owner}")
        print(f"Repository : {repo_name}")
        print(f"Visibility : {args.visibility}")
        print(f"Local Path : {directory}")
        print(f"GitHub URL : {html_url}")
        print("=" * 60)

    except KeyboardInterrupt:
        UI.error("Operation cancelled by user.")
        sys.exit(130)

    except (ValueError, RuntimeError) as exc:
        UI.error(str(exc))
        sys.exit(1)

    except Exception as exc:
        UI.error(f"Unexpected error: {exc}")
        sys.exit(1)


if __name__ == "__main__":
    main()

